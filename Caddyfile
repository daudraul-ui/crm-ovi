{$CRM_DOMAIN:localhost} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
    @private path /media/* /private_media/* /.env /.git/*
    respond @private 404
    request_body {
        max_size 12MB
    }
    reverse_proxy web:8000
}
